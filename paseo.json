{
  "worktree": {
    "setup": [
      "git submodule update --init --recursive",
      "npm ci --prefix shared --ignore-scripts --no-audit --no-fund",
      "npm ci --prefix skills/react-doctor --ignore-scripts --no-audit --no-fund",
      "npm ci --prefix paseo/tool-trust --ignore-scripts --no-audit --no-fund"
    ]
  },
  "scripts": {
    "verify": {
      "command": "bash verify.sh"
    },
    "paseo-trust-check": {
      "command": "npm run typecheck --prefix paseo/tool-trust && npm test --prefix paseo/tool-trust"
    }
  }
}
