#!/usr/bin/env bash
set -euo pipefail

if [[ ${1:-} == "--help" || ${1:-} == "-h" ]]; then
  printf 'usage: %s [changed|full|lines] [react-doctor options...]\n' "$0"
  exit 0
fi

scope=${1:-changed}
case "$scope" in
  changed|lines) scope_args=(--scope "$scope" --include-untracked) ;;
  full) scope_args=(--scope full) ;;
  *) printf 'usage: %s [changed|full|lines] [react-doctor options...]\n' "$0" >&2; exit 2 ;;
esac
shift || true
for option in "$@"; do
  case "$option" in
    --|--score|--supply-chain)
      printf 'react-doctor wrapper refuses privacy override: %s\n' "$option" >&2
      exit 2
      ;;
  esac
done

# Force the public registry: the scanned repository's .npmrc must not choose where the scanner comes from.
# Skip dependency install scripts. Scoped registries in that .npmrc still apply; this is a known limit.
exec npm exec --yes --ignore-scripts --registry=https://registry.npmjs.org/ --package=react-doctor@0.9.23 -- \
  react-doctor . --verbose "$@" \
  "${scope_args[@]}" --no-telemetry --no-supply-chain
