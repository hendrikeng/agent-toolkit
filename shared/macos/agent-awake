#!/bin/bash
set -euo pipefail
export LC_ALL=C
umask 077

label=com.agent-toolkit.awake
domain=gui/$(id -u)
agents_dir=$HOME/Library/LaunchAgents
# Test-only: AGENT_AWAKE_TEST_ROOT replaces the LaunchAgents directory and records launchctl calls
# instead of running them. It runs no program from the test root, and the label stays fixed.
test_root=${AGENT_AWAKE_TEST_ROOT:-}
[[ -z $test_root ]] || agents_dir=$test_root/LaunchAgents
plist=$agents_dir/$label.plist
state_dir=${XDG_STATE_HOME:-"$HOME/.local/state"}/agent-toolkit
pid_file=$state_dir/caffeinate.pid
lock_file=$state_dir/caffeinate.lock

launchctl() {
  if [[ -z $test_root ]]; then /bin/launchctl "$@"; return; fi
  printf '%s\n' "$*" >> "$test_root/launchctl.log"
  case $1 in
    print) [[ -e $test_root/loaded ]] ;;
    bootstrap) : > "$test_root/loaded" ;;
    bootout) [[ -e $test_root/loaded ]] && rm "$test_root/loaded" ;;
  esac
}
loaded() { launchctl print "$domain/$label" >/dev/null 2>&1; }

if [[ ${1:-} == --status ]]; then
  if loaded; then echo "LaunchAgent $label is loaded."; else echo "LaunchAgent $label is not loaded."; fi
  if /usr/bin/pmset -g assertions | grep -q 'PreventUserIdleSystemSleep named: "caffeinate'; then
    echo 'A caffeinate hold prevents idle sleep.'
  else
    echo 'No caffeinate hold is active.'
  fi
  exit 0
fi

mkdir -p "$state_dir"
if [[ ${1:-} != --locked ]]; then
  exec /usr/bin/lockf -k -t 5 "$lock_file" "$0" --locked
fi

# Migration: stop the caffeinate process that earlier versions started and tracked in the PID file.
stopped_old=
if [[ -L $pid_file ]]; then
  echo "Refusing a symlink PID file: $pid_file" >&2
  exit 1
elif [[ -f $pid_file ]]; then
  pid= started=
  { IFS= read -r pid || true; IFS= read -r started || true; } < "$pid_file"
  # Keep the PID file if ps cannot run (for example in the Claude sandbox), so a later run can stop the process.
  /bin/ps -p $$ >/dev/null 2>&1 || { echo "Cannot run /bin/ps; kept $pid_file." >&2; exit 1; }
  if [[ $pid =~ ^[1-9][0-9]*$ && $pid != 1 && -n $started ]] &&
    [[ $(/bin/ps -p "$pid" -o lstart= 2>/dev/null) == "$started" ]] &&
    [[ $(/bin/ps -p "$pid" -o uid= 2>/dev/null | tr -d ' ') == "$(id -u)" ]] &&
    [[ $(/bin/ps -p "$pid" -o command= 2>/dev/null) == '/usr/bin/caffeinate -i' ]]; then
    kill "$pid" 2>/dev/null && stopped_old=1
  fi
  rm -f "$pid_file"
fi

case ${0##*/} in
  agent-awake|paseo-awake)
    if loaded; then
      echo 'Already keeping the Mac awake.'
      exit 0
    fi
    mkdir -p "$agents_dir"
    if [[ -L $plist ]]; then
      echo "Refusing a symlink plist: $plist" >&2
      exit 1
    fi
    tmp=$(mktemp "$agents_dir/.$label.XXXXXX")
    trap 'rm -f -- "$tmp"' EXIT
    cat > "$tmp" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$label</string>
  <key>ProgramArguments</key><array><string>/usr/bin/caffeinate</string><string>-i</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
</dict>
</plist>
EOF
    chmod 644 "$tmp"
    mv -f "$tmp" "$plist"
    launchctl enable "$domain/$label"
    launchctl bootstrap "$domain" "$plist"
    echo 'Keeping the Mac awake, also after a restart. Run agent-sleep when done.'
    ;;
  agent-sleep|paseo-sleep)
    if launchctl bootout "$domain/$label" >/dev/null 2>&1 || [[ -n $stopped_old ]]; then
      echo 'Stopped keep-awake; normal sleep is allowed.'
    else
      echo 'Keep-awake is already stopped; normal sleep is allowed.'
    fi
    rm -f "$plist"
    ;;
  *) echo "Run this command as agent-awake or agent-sleep." >&2; exit 2 ;;
esac
