#!/bin/bash
set -euo pipefail
export LC_ALL=C
umask 077

label=com.agent-toolkit.awake
domain=gui/$(id -u)
agents_dir=$HOME/Library/LaunchAgents
launchctl=/bin/launchctl
plist=$agents_dir/$label.plist
# A fixed path: the caller controls XDG_STATE_HOME, and this script runs outside the sandbox.
state_dir=$HOME/.local/state/agent-toolkit
lock_file=$state_dir/caffeinate.lock

# launchctl print exits 113 only when the service does not exist. Any other failure leaves the state unknown.
print_status() { local rc=0; "$launchctl" print "$domain/$label" >/dev/null 2>&1 || rc=$?; echo "$rc"; }
loaded() {
  case $(print_status) in
    0) return 0 ;;
    113) return 1 ;;
    *) echo "Could not check $label; keep-awake may still be on." >&2; exit 1 ;;
  esac
}

if [[ ${1:-} == --status ]]; then
  status=0
  case $(print_status) in
    0) echo "LaunchAgent $label is loaded." ;;
    113) echo "LaunchAgent $label is not loaded." ;;
    *) echo "LaunchAgent $label state is unknown: launchctl print failed."; status=1 ;;
  esac
  # grep reads all input: with pipefail, an early grep -q exit fails the pipeline through SIGPIPE.
  if /usr/bin/pmset -g assertions | grep 'PreventUserIdleSystemSleep named: "caffeinate' >/dev/null; then
    echo 'A caffeinate hold prevents idle sleep.'
  else
    echo 'No caffeinate hold is active.'
  fi
  exit "$status"
fi

mkdir -p "$state_dir"
if [[ -L $state_dir || -L $lock_file ]]; then
  echo "Refusing a symlinked lock path: $lock_file" >&2
  exit 1
fi
# Lock an open descriptor: no flag or re-exec can skip the lock. It holds until this script exits.
exec 9>>"$lock_file"
/usr/bin/lockf -t 5 9

stopped=
case ${0##*/} in
  agent-awake|paseo-awake)
    if loaded; then
      echo 'Already keeping the Mac awake.'
      exit 0
    fi
    mkdir -p "$agents_dir"
    if [[ -L $plist ]]; then
      echo "Refusing a symlink plist: $plist" >&2
      exit 1
    fi
    tmp=$(mktemp "$agents_dir/.$label.XXXXXX")
    trap 'rm -f -- "$tmp"' EXIT
    cat > "$tmp" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$label</string>
  <key>ProgramArguments</key><array><string>/usr/bin/caffeinate</string><string>-i</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
</dict>
</plist>
EOF
    chmod 644 "$tmp"
    mv -f "$tmp" "$plist"
    "$launchctl" enable "$domain/$label"
    "$launchctl" bootstrap "$domain" "$plist"
    echo 'Keeping the Mac awake, also after a restart. Run agent-sleep when done.'
    ;;
  agent-sleep|paseo-sleep)
    if loaded; then
      "$launchctl" bootout "$domain/$label" || true
      if loaded; then
        echo "Could not unload $label; keep-awake is still on." >&2
        exit 1
      fi
      stopped=1
    fi
    rm -f "$plist"
    if [[ -n $stopped ]]; then
      echo 'Stopped keep-awake; normal sleep is allowed.'
    else
      echo 'Keep-awake is already stopped; normal sleep is allowed.'
    fi
    ;;
  *) echo "Run this command as agent-awake or agent-sleep." >&2; exit 2 ;;
esac
