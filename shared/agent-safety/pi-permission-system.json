{
  "permissionReviewLog": false,
  "yoloMode": false,
  "piInfrastructureReadPaths": [],
  "permission": {
    "*": "allow",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.credentials.json": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*/.npmrc": "deny",
      "*/.pypirc": "deny",
      "*/.netrc": "deny",
      "*/.git-credentials": "deny",
      "*/.git/config": "deny",
      "*/.git/hooks*": "deny",
      "*/.pi/settings.json": "deny",
      "*/.pi/extensions*": "deny",
      "*/.claude/settings*.json": "deny",
      "*/.codex/config.toml": "deny"
    },
    "read": "allow",
    "write": "allow",
    "edit": "allow",
    "external_directory": { "*": "deny" },
    "bash": {
      "*": "allow",
      "git push*": "ask",
      "git reset --hard*": "ask",
      "git clean *": "ask",
      "git branch -D *": "ask"
    }
  }
}
