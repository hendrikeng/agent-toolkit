{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "permissionReviewLog": false,
  "piInfrastructureReadPaths": [],
  "permission": {
    "*": "allow",
    "path": {
      "*": "allow",
      "*.env": "ask",
      "*.env.*": "ask",
      "*.env.example": "allow",
      "*.pem": "ask",
      "*.key": "ask",
      "~/.ssh": "deny",
      "~/.ssh/*": "deny",
      "~/.gnupg": "deny",
      "~/.gnupg/*": "deny",
      "~/.aws": "deny",
      "~/.aws/*": "deny",
      "~/.azure": "deny",
      "~/.azure/*": "deny",
      "~/.config/gcloud": "deny",
      "~/.config/gcloud/*": "deny",
      "~/.kube": "deny",
      "~/.kube/*": "deny",
      "~/.docker/config.json": "deny",
      "~/.npmrc": "deny",
      "~/.pypirc": "deny",
      "~/.netrc": "deny",
      "~/.git-credentials": "deny",
      "~/Library/Keychains": "deny",
      "~/Library/Keychains/*": "deny",
      "~/.claude/.credentials.json": "deny",
      "~/.codex/auth.json": "deny",
      "~/.pi/agent/auth.json": "deny"
    },
    "read": "allow",
    "write": "allow",
    "edit": "allow",
    "external_directory": "ask",
    "bash": {
      "*": "allow",
      "rm *": "ask",
      "*/rm *": "ask",
      "command rm *": "ask",
      "rmdir *": "ask",
      "*/rmdir *": "ask",
      "command rmdir *": "ask",
      "unlink *": "ask",
      "*/unlink *": "ask",
      "command unlink *": "ask",
      "shred *": "ask",
      "*/shred *": "ask",
      "truncate *": "ask",
      "*/truncate *": "ask",
      "dd *": "ask",
      "*/dd *": "ask",
      "find * -delete*": "ask",
      "*/find * -delete*": "ask",
      "command *": "ask",
      "command -v *": "allow",
      "command -V *": "allow",
      "exec *": "ask",
      "builtin *": "ask",
      "*/env *": "ask",
      "*/sudo *": "ask",
      "*/sh -c *": "ask",
      "*/bash -c *": "ask",
      "*/zsh -c *": "ask",
      "git -*": "ask",
      "*/git -*": "ask",
      "git -C *": "ask",
      "git -c *": "ask",
      "git --git-dir*": "ask",
      "git --work-tree*": "ask",
      "git --namespace*": "ask",
      "git --bare*": "ask",
      "git clean *": "ask",
      "*/git clean *": "ask",
      "git reset --hard *": "ask",
      "*/git reset --hard *": "ask",
      "git checkout -- *": "ask",
      "*/git checkout -- *": "ask",
      "git restore *": "ask",
      "*/git restore *": "ask",
      "git branch -D *": "ask",
      "*/git branch -D *": "ask"
    }
  }
}
