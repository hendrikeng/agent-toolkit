{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "permissionReviewLog": false,
  "yoloMode": false,
  "piInfrastructureReadPaths": [],
  "permission": {
    "*": "allow",
    "path": {
      "*": "allow",
      "*.env": "ask",
      "*.env.*": "ask",
      "*.env.example": "allow",
      "*.pem": "ask",
      "*.key": "ask",
      "~/.ssh": "deny",
      "~/.ssh/*": "deny",
      "~/.gnupg": "deny",
      "~/.gnupg/*": "deny",
      "~/.aws": "deny",
      "~/.aws/*": "deny",
      "~/.azure": "deny",
      "~/.azure/*": "deny",
      "~/.config/gcloud": "deny",
      "~/.config/gcloud/*": "deny",
      "~/.kube": "deny",
      "~/.kube/*": "deny",
      "~/.docker/config.json": "deny",
      "~/.npmrc": "deny",
      "~/.pypirc": "deny",
      "~/.netrc": "deny",
      "~/.git-credentials": "deny",
      "~/Library/Keychains": "deny",
      "~/Library/Keychains/*": "deny",
      "~/.claude/.credentials.json": "deny",
      "~/.codex/auth.json": "deny",
      "~/.codex-accounts/*/auth.json": "deny",
      "~/.pi/agent/auth.json": "deny",
      "~/.pi/agent/auth-profiles": "deny",
      "~/.pi/agent/auth-profiles/*": "deny",
      "~/.pi/agent/codex-fast.json": "deny"
    },
    "read": "allow",
    "write": "allow",
    "edit": "allow",
    "external_directory": "ask",
    "bash": {
      "*": "allow",
      "command *": "deny",
      "command -v *": "allow",
      "command -V *": "allow",
      "exec *": "deny",
      "builtin *": "deny",
      "env *": "deny",
      "*/env *": "deny",
      "sh -c *": "deny",
      "*/sh -c *": "deny",
      "bash -c *": "deny",
      "*/bash -c *": "deny",
      "zsh -c *": "deny",
      "*/zsh -c *": "deny",
      "git -*": "ask",
      "*/git -*": "ask",
      "git -C *": "ask",
      "git -c *": "ask",
      "git --git-dir*": "ask",
      "git --work-tree*": "ask",
      "git --namespace*": "ask",
      "git --bare*": "ask",
      "git push -*": "ask",
      "*/git push -*": "ask",
      "rm *": "deny",
      "*/rm *": "deny",
      "command rm *": "deny",
      "rmdir *": "deny",
      "*/rmdir *": "deny",
      "command rmdir *": "deny",
      "unlink *": "deny",
      "*/unlink *": "deny",
      "command unlink *": "deny",
      "shred *": "deny",
      "*/shred *": "deny",
      "truncate *": "deny",
      "*/truncate *": "deny",
      "dd *": "deny",
      "*/dd *": "deny",
      "find * -delete*": "deny",
      "*/find * -delete*": "deny",
      "sudo *": "deny",
      "*/sudo *": "deny",
      "git clean *": "deny",
      "*/git clean *": "deny",
      "git reset --hard": "deny",
      "git reset --hard *": "deny",
      "*/git reset --hard": "deny",
      "*/git reset --hard *": "deny",
      "git checkout -- *": "deny",
      "*/git checkout -- *": "deny",
      "git restore *": "deny",
      "*/git restore *": "deny",
      "git branch -D *": "deny",
      "git branch -d*": "deny",
      "git branch --delete*": "deny",
      "*/git branch -D *": "deny",
      "*/git branch -d*": "deny",
      "*/git branch --delete*": "deny",
      "git push *--force*": "deny",
      "*/git push *--force*": "deny",
      "git push -f*": "deny",
      "git push * -f*": "deny",
      "*/git push -f*": "deny",
      "*/git push * -f*": "deny",
      "git -* clean*": "deny",
      "*/git -* clean*": "deny",
      "git -* reset --hard*": "deny",
      "*/git -* reset --hard*": "deny",
      "git -* checkout -- *": "deny",
      "*/git -* checkout -- *": "deny",
      "git -* restore *": "deny",
      "*/git -* restore *": "deny",
      "git -* branch -D *": "deny",
      "git -* branch -d*": "deny",
      "git -* branch --delete*": "deny",
      "*/git -* branch -D *": "deny",
      "*/git -* branch -d*": "deny",
      "*/git -* branch --delete*": "deny",
      "git -* push *--force*": "deny",
      "*/git -* push *--force*": "deny",
      "git -* push -f*": "deny",
      "git -* push * -f*": "deny",
      "*/git -* push -f*": "deny",
      "*/git -* push * -f*": "deny"
    }
  }
}
