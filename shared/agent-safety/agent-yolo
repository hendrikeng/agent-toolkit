#!/usr/bin/env bash
set -euo pipefail

system_home=$(node -p 'require("node:os").userInfo().homedir')
policy_helper=$system_home/.local/libexec/agent-toolkit/development-policy.cjs

verify_agent_rules() {
  agent_rules=$system_home/.local/libexec/agent-toolkit/AGENTS.md
  marker=$agent_rules.agent-toolkit.sha256
  [[ -f $agent_rules && ! -L $agent_rules && -f $marker && ! -L $marker ]] || { printf '%s: run agent-toolkit/install.sh first\n' "${0##*/}" >&2; exit 1; }
  [[ $(<"$marker") == "$(shasum -a 256 "$agent_rules" | awk '{print $1}')" ]] || {
    printf '%s: installed agent rules failed their integrity check\n' "${0##*/}" >&2
    exit 1
  }
}

start_pg_test_session() {
  AGENT_TOOLKIT_SESSION_ID=$(node -p 'require("node:crypto").randomUUID()')
  AGENT_TOOLKIT_SESSION_PID=$$
  export AGENT_TOOLKIT_SESSION_ID AGENT_TOOLKIT_SESSION_PID
  if [[ -x $system_home/.local/bin/pg-test ]]; then
    "$system_home/.local/bin/pg-test" watch-session >/dev/null &
  fi
}

prepare_development() {
  marker=$policy_helper.agent-toolkit.sha256
  [[ -f $policy_helper && ! -L $policy_helper && -f $marker && ! -L $marker && $(shasum -a 256 "$policy_helper" | awk '{print $1}') == "$(<"$marker")" ]] || {
    printf '%s: run agent-toolkit/install.sh first\n' "${0##*/}" >&2; exit 1;
  }
  AGENT_TOOLKIT_ORCHESTRATION_HOST=$(node "$policy_helper" orchestration-host)
  export AGENT_TOOLKIT_ORCHESTRATION_HOST
  AGENT_TOOLKIT_WORKSPACE=$(node "$policy_helper" workspace "$system_home")
  AGENT_TOOLKIT_SESSION_DIR=$(node "$policy_helper" prepare "$system_home")
  export AGENT_TOOLKIT_WORKSPACE AGENT_TOOLKIT_SESSION_DIR
  session_rules=$AGENT_TOOLKIT_SESSION_DIR/AGENTS.md
  node "$policy_helper" session-rules "$agent_rules" "$session_rules"
  export TMPDIR=$AGENT_TOOLKIT_SESSION_DIR/tmp XDG_CACHE_HOME=$AGENT_TOOLKIT_SESSION_DIR/cache
  export npm_config_cache=$XDG_CACHE_HOME/npm UV_CACHE_DIR=$XDG_CACHE_HOME/uv PIP_CACHE_DIR=$XDG_CACHE_HOME/pip
  export COREPACK_HOME=$XDG_CACHE_HOME/corepack PLAYWRIGHT_BROWSERS_PATH=$XDG_CACHE_HOME/playwright
  export AGENT_TOOLKIT_REVIEW_ROOT=$AGENT_TOOLKIT_SESSION_DIR/reviews
  GIT_CONFIG_GLOBAL=$(node "$policy_helper" git-config "$AGENT_TOOLKIT_SESSION_DIR" "$system_home")
  export GIT_CONFIG_GLOBAL GIT_CONFIG_NOSYSTEM=1 xcrun_nocache=1
  cd "$AGENT_TOOLKIT_WORKSPACE"
  start_pg_test_session
}

case ${0##*/} in
  pg18-fresh-yolo)
    [[ $# -eq 0 ]] || { printf 'pg18-fresh-yolo: arguments are disabled\n' >&2; exit 2; }
    helper=$system_home/.local/libexec/agent-toolkit/pg18-fresh-yolo
    marker=$helper.agent-toolkit.sha256
    [[ -x $helper && ! -L $helper && -f $marker && ! -L $marker ]] || { printf 'pg18-fresh-yolo: run agent-toolkit/install.sh first\n' >&2; exit 1; }
    [[ $(<"$marker") == "$(shasum -a 256 "$helper" | awk '{print $1}')" ]] || {
      printf 'pg18-fresh-yolo: installed helper failed its integrity check\n' >&2
      exit 1
    }
    exec "$helper"
    ;;
  autoreview-yolo)
    [[ $# -eq 0 ]] || { printf 'autoreview-yolo: arguments are disabled\n' >&2; exit 2; }
    helper=$system_home/.local/libexec/agent-toolkit/autoreview
    marker=$helper.agent-toolkit.sha256
    [[ -x $helper && ! -L $helper && -f $marker && ! -L $marker ]] || { printf 'autoreview-yolo: run agent-toolkit/install.sh first\n' >&2; exit 1; }
    [[ $(<"$marker") == "$(shasum -a 256 "$helper" | awk '{print $1}')" ]] || {
      printf 'autoreview-yolo: installed helper failed its integrity check\n' >&2
      exit 1
    }
    review_root=${AGENT_TOOLKIT_REVIEW_ROOT:-$system_home/Code/.agent-toolkit-reports}
    [[ -d $review_root ]] || { printf 'autoreview-yolo: review root is unavailable; run agent-toolkit/install.sh first\n' >&2; exit 1; }
    output_dir=$(mktemp -d "$review_root/review-XXXXXXXX")
    printf 'review output directory: %s\n' "$output_dir"
    # Claude's sandbox exports a shared TMPDIR that the Codex reviewer refuses on macOS,
    # and Python falls back to /tmp without one, so pin the private per-user directory.
    unset TMPDIR TMP TEMP
    [[ $(uname -s) != Darwin ]] || export TMPDIR=$(getconf DARWIN_USER_TEMP_DIR)
    exec "$helper" --mode local --output "$output_dir/report.txt" --json-output "$output_dir/report.json" --status-output "$output_dir/status.json"
    ;;
  codex-yolo)
    verify_agent_rules
    prepare_development
    node "$policy_helper" validate-codex "$@"
    node "$policy_helper" check-codex-config "$AGENT_TOOLKIT_WORKSPACE" "$system_home" "${CODEX_HOME:-$system_home/.codex}"
    node "$policy_helper" check-engine codex
    rules=${CODEX_HOME:-$system_home/.codex}/rules/agent-toolkit-development.rules
    shared_rules=$system_home/.local/libexec/agent-toolkit/development.rules
    if [[ -e $rules || -L $rules ]]; then
      [[ ! -L $rules ]] && cmp -s "$shared_rules" "$rules" || { printf 'codex-yolo: unexpected development rules; run install.sh from a trusted terminal\n' >&2; exit 1; }
    else
      mkdir -p "${rules%/*}"
      cp "$shared_rules" "$rules"
      chmod 600 "$rules"
    fi
    [[ ! -e ${rules%/*}/agent-safety.rules ]] || { printf 'codex-yolo: remove the retired agent-safety.rules through the reviewed installer\n' >&2; exit 1; }
    codex_instructions=$(node "$policy_helper" instructions "$session_rules")
    native_profile=$(node "$policy_helper" codex "$AGENT_TOOLKIT_WORKSPACE" "$AGENT_TOOLKIT_SESSION_DIR" "$system_home")
    exec codex --ask-for-approval never --no-daemon -c 'default_permissions="agent_toolkit"' -c "permissions.agent_toolkit=$native_profile" -c features.network_proxy=true -c 'shell_environment_policy.exclude=["*TOKEN*","*PASSWORD*","*SECRET*","*API_KEY*","*CREDENTIAL*","DATABASE_URL","PGHOST","PGPORT","PGUSER","PGDATABASE","SSH_AUTH_SOCK","DOCKER_HOST","DOCKER_CONTEXT"]' -c "developer_instructions=$codex_instructions" "$@"
    ;;
  claude-yolo)
    verify_agent_rules
    prepare_development
    node "$policy_helper" check-engine claude
    node "$policy_helper" claude "$AGENT_TOOLKIT_WORKSPACE" "$AGENT_TOOLKIT_SESSION_DIR" "${CLAUDE_CONFIG_DIR:-$system_home/.claude}/settings.json" "$system_home"
    claude_has_model=false
    claude_has_effort=false
    for argument in "$@"; do
      [[ $argument != -- ]] || break
      case $argument in
      --model|--model=*) claude_has_model=true ;;
      --effort|--effort=*) claude_has_effort=true ;;
      --permission-mode|--permission-mode=*|--settings|--settings=*|--dangerously-skip-permissions|--allow-dangerously-skip-permissions|--add-dir|--add-dir=*|--worktree|--worktree=*|-w|--tools|--tools=*|--allowedTools|--allowedTools=*|--allowed-tools|--allowed-tools=*|--setting-sources|--setting-sources=*)
        printf 'claude-yolo: safety overrides are disabled\n' >&2
        exit 2
        ;;
      esac
    done
    claude_args=(--restricted --tools Bash,Read,Edit,Write,Glob,Grep,WebSearch,WebFetch,AskUserQuestion,Agent,TodoWrite,Skill --permission-mode acceptEdits --settings "$AGENT_TOOLKIT_SESSION_DIR/claude.json" --append-system-prompt-file "$session_rules")
    [[ $claude_has_model == true ]] || claude_args+=(--model opus)
    [[ $claude_has_effort == true ]] || claude_args+=(--effort medium)
    claude_args+=("$@")
    exec claude "${claude_args[@]}"
    ;;
  pi-yolo)
    verify_agent_rules
    source_agent_dir=$system_home/.pi/agent
    source_web_config_dir=$system_home/.pi
    policy=$source_agent_dir/extensions/pi-permission-system/config.json
    [[ -f $policy ]] || { printf 'pi-yolo: run agent-toolkit/install.sh first\n' >&2; exit 1; }
    prepare_development
    export HOME=$system_home
    node "$policy_helper" check-codex-config "$AGENT_TOOLKIT_WORKSPACE" "$system_home" "${CODEX_HOME:-$system_home/.codex}"
    node "$policy_helper" check-engine codex
    node "$policy_helper" check-pi "$(command -v pi)"
    for argument in "$@"; do
      [[ $argument != -- ]] || break
      case $argument in
        --no-extensions|--no-extensions=*|-ne|--extension|--extension=*|-e|--approve|--approve=*|-a|--no-context-files|-nc|--system-prompt|--system-prompt=*)
          printf 'pi-yolo: sandbox and shared-instruction overrides are disabled\n' >&2; exit 2 ;;
      esac
    done

    account_profile=
    pinned_account=false
    codex_accounts_root=$(node -p 'require("node:path").resolve(process.argv[1])' "$system_home/.codex-accounts")
    codex_home=$(node -p 'require("node:path").resolve(process.argv[1])' "${AGENT_TOOLKIT_CODEX_PROFILE_HOME:-${CODEX_HOME:-$system_home/.codex}}")
    if [[ -n ${AGENT_TOOLKIT_CODEX_ACCOUNT_EMAIL_B64:-} ]]; then
      [[ -n ${AGENT_TOOLKIT_CODEX_ACCOUNT_ID:-} && ${AGENT_TOOLKIT_CODEX_PROFILE_SHA256:-} =~ ^[a-f0-9]{64}$ ]] || { printf 'pi-yolo: incomplete selected account identity\n' >&2; exit 1; }
      account_profile=$(node --experimental-strip-types --input-type=module - "$source_agent_dir/extensions/codex-account/index.ts" "$source_agent_dir" "$codex_accounts_root" "$AGENT_TOOLKIT_CODEX_ACCOUNT_EMAIL_B64" "${AGENT_TOOLKIT_CODEX_ACCOUNT_ID:-}" "${AGENT_TOOLKIT_CODEX_PROFILE_SHA256:-}" <<'NODE'
import { createHash } from "node:crypto";
import { join } from "node:path";
import { pathToFileURL } from "node:url";
const { piAccountEmail, piAccounts, piProfileAccountId } = await import(pathToFileURL(process.argv[2]).href);
const email = Buffer.from(process.argv[5], "base64url").toString("utf8");
const matches = piAccounts(process.argv[3], process.argv[4]).filter(({ profile }) =>
  piAccountEmail(join(process.argv[3], "auth-profiles", profile))?.toLowerCase() === email.toLowerCase()
  && piProfileAccountId(profile, process.argv[3]) === process.argv[6]
  && createHash("sha256").update(profile).digest("hex") === process.argv[7]
).sort((a, b) => a.profile.localeCompare(b.profile));
if (!matches.length) process.exit(1);
process.stdout.write(matches[0].profile);
NODE
      ) || { printf 'pi-yolo: no unique login found for selected email\n' >&2; exit 1; }
      codex_home=$codex_accounts_root/$account_profile
      pinned_account=true
    else
      case $codex_home in
        "$codex_accounts_root"/*)
          candidate=${codex_home#"$codex_accounts_root"/}
          if [[ $candidate != */* && $candidate =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ && ${AGENT_TOOLKIT_CODEX_ACCOUNT:-$candidate} == "$candidate" ]]; then
            account_profile=$candidate
          fi
          ;;
      esac
      if [[ -z $account_profile && -f $source_agent_dir/active-codex-account.json ]]; then
        candidate=$(node - "$source_agent_dir/active-codex-account.json" <<'NODE'
const fs = require("node:fs");
try {
  const profile = JSON.parse(fs.readFileSync(process.argv[2], "utf8"))?.profile;
  if (typeof profile === "string" && /^[A-Za-z0-9][A-Za-z0-9._-]*$/.test(profile)) process.stdout.write(profile);
} catch {}
NODE
        )
        if [[ -n $candidate && -f $source_agent_dir/auth-profiles/$candidate/auth.json && -f $codex_accounts_root/$candidate/auth.json ]]; then
          account_profile=$candidate
          codex_home=$codex_accounts_root/$candidate
        fi
      fi
    fi
    unset AGENT_TOOLKIT_CODEX_ACCOUNT_EMAIL_B64 AGENT_TOOLKIT_CODEX_ACCOUNT_ID AGENT_TOOLKIT_CODEX_PROFILE_SHA256
    agent_dir=$AGENT_TOOLKIT_SESSION_DIR/pi
    mkdir "$agent_dir"
    ln -s "$session_rules" "$agent_dir/AGENTS.md"
    if [[ -n $account_profile ]]; then
      profile_dir=$source_agent_dir/auth-profiles/$account_profile
      profile_auth=$profile_dir/auth.json
      node - "$source_agent_dir/auth.json" "$profile_dir" "$profile_auth" "$codex_home/auth.json" "$pinned_account" <<'NODE'
const fs = require("node:fs");
const path = require("node:path");
function ensurePrivateDirectory(directory) {
  try { fs.mkdirSync(directory, { mode: 0o700 }); } catch (error) { if (error.code !== "EEXIST") throw error; }
  const stat = fs.lstatSync(directory);
  if (stat.isSymbolicLink() || !stat.isDirectory()) throw new Error(`unsafe profile directory: ${directory}`);
  fs.chmodSync(directory, 0o700);
}
function readJson(file) {
  try { return JSON.parse(fs.readFileSync(file, "utf8")); } catch { return undefined; }
}
function jwtClaims(token) {
  try { return JSON.parse(Buffer.from(token.split(".")[1] || "", "base64url").toString("utf8")); } catch { return {}; }
}
for (const directory of [path.dirname(process.argv[3]), process.argv[3]]) ensurePrivateDirectory(directory);
if (fs.existsSync(process.argv[4])) {
  const stat = fs.lstatSync(process.argv[4]);
  if (stat.isSymbolicLink() || !stat.isFile()) throw new Error(`unsafe profile auth path: ${process.argv[4]}`);
}
let auth = readJson(process.argv[4]);
const existing = Boolean(auth);
if (!auth) {
  auth = readJson(process.argv[2]) || {};
  auth = Object.fromEntries(Object.entries(auth).filter(([, credential]) => credential?.type !== "oauth"));
}
let changed = false;
const codex = process.argv[6] === "true" ? undefined : readJson(process.argv[5]);
const access = codex?.tokens?.access_token;
const refresh = codex?.tokens?.refresh_token;
const claims = typeof access === "string" ? jwtClaims(access) : {};
const accountId = codex?.tokens?.account_id || claims["https://api.openai.com/auth"]?.chatgpt_account_id;
const credential = auth["openai-codex"];
const codexExpires = Number(claims.exp) * 1000;
const credentialExpires = Number(credential?.expires) || Number(jwtClaims(credential?.access).exp) * 1000 || 0;
if (
  typeof access === "string" && typeof refresh === "string" && typeof accountId === "string"
  && (!credential?.access || codexExpires > credentialExpires)
) {
  auth["openai-codex"] = { type: "oauth", access, refresh, expires: Number.isFinite(codexExpires) && codexExpires > 0 ? codexExpires : Date.now() + 300000, accountId };
  changed = true;
}
if (!existing) {
  try { fs.writeFileSync(process.argv[4], `${JSON.stringify(auth, null, 2)}\n`, { flag: "wx", mode: 0o600 }); } catch (error) { if (error.code !== "EEXIST") throw error; }
} else if (changed) {
  const temporary = `${process.argv[4]}.${process.pid}`;
  fs.writeFileSync(temporary, `${JSON.stringify(auth, null, 2)}\n`, { mode: 0o600 });
  fs.renameSync(temporary, process.argv[4]);
}
const authStat = fs.lstatSync(process.argv[4]);
if (authStat.isSymbolicLink() || !authStat.isFile()) throw new Error(`unsafe profile auth path: ${process.argv[4]}`);
fs.chmodSync(process.argv[4], 0o600);
const stored = readJson(process.argv[4]);
const storedCredential = stored?.["openai-codex"];
if (typeof storedCredential?.access !== "string" || typeof storedCredential?.refresh !== "string" || typeof storedCredential?.accountId !== "string") {
  throw new Error(`invalid profile auth: ${process.argv[4]}`);
}
if (codex?.tokens && typeof access === "string" && typeof refresh === "string") {
  const storedExpires = Number(storedCredential.expires) || Number(jwtClaims(storedCredential.access).exp) * 1000 || 0;
  if (storedCredential.access !== access && storedExpires < codexExpires) throw new Error("Codex login was not imported");
  delete codex.tokens.access_token;
  delete codex.tokens.refresh_token;
  const temporary = `${process.argv[5]}.${process.pid}`;
  fs.writeFileSync(temporary, `${JSON.stringify(codex, null, 2)}\n`, { mode: 0o600 });
  fs.renameSync(temporary, process.argv[5]);
}
NODE
      cp "$profile_auth" "$agent_dir/auth.json"
      chmod 600 "$agent_dir/auth.json"
      for source in "$source_agent_dir"/*; do
        name=${source##*/}
        [[ $name == AGENTS.md || $name == auth.json || $name == auth-profiles || $name == extensions ]] || ln -s "$source" "$agent_dir/$name"
      done
      mkdir "$agent_dir/extensions"
      for source in "$source_agent_dir/extensions"/*; do
        name=${source##*/}
        [[ $name == pi-permission-system ]] || ln -s "$source" "$agent_dir/extensions/$name"
      done
      mkdir "$agent_dir/extensions/pi-permission-system"
    else
      for source in "$source_agent_dir"/*; do
        [[ ${source##*/} == AGENTS.md || ${source##*/} == extensions ]] || ln -s "$source" "$agent_dir/${source##*/}"
      done
      mkdir "$agent_dir/extensions"
      for source in "$source_agent_dir/extensions"/*; do
        [[ ${source##*/} == pi-permission-system ]] || ln -s "$source" "$agent_dir/extensions/${source##*/}"
      done
      mkdir "$agent_dir/extensions/pi-permission-system"
    fi
    sandbox_extension=$source_agent_dir/extensions/workspace-sandbox/index.ts
    [[ -f $sandbox_extension && ! -L $sandbox_extension && -f $sandbox_extension.agent-toolkit.sha256 && ! -L $sandbox_extension.agent-toolkit.sha256 && $(shasum -a 256 "$sandbox_extension" | awk '{print $1}') == "$(<"$sandbox_extension.agent-toolkit.sha256")" ]] || {
      printf 'pi-yolo: install the workspace sandbox from a trusted terminal\n' >&2; exit 1;
    }
    node "$policy_helper" pi "$policy" "$agent_dir/extensions/pi-permission-system/config.json" "$system_home"
    if [[ -n $account_profile ]]; then
      export AGENT_TOOLKIT_CODEX_PROFILE_HOME=$codex_home
    else
      unset AGENT_TOOLKIT_CODEX_PROFILE_HOME
    fi
    has_model=false
    has_thinking=false
    for argument in "$@"; do
      [[ $argument != -- ]] || break
      case $argument in
        -a|--approve) printf 'pi-yolo: project trust overrides are disabled\n' >&2; exit 2 ;;
        --model|--model=*) has_model=true ;;
        --thinking|--thinking=*) has_thinking=true ;;
      esac
    done
    pi_args=(--no-approve)
    [[ $has_model == true ]] || pi_args+=(--model openai-codex/gpt-6.1-sol)
    [[ $has_thinking == true ]] || pi_args+=(--thinking high)
    pi_args+=("$@")
    PATH=$PATH \
      AGENT_TOOLKIT_CODEX_ACCOUNT=$account_profile \
      AGENT_TOOLKIT_PI_AGENT_DIR=$source_agent_dir \
      AGENT_TOOLKIT_PI_WEB_CONFIG_DIR=$source_web_config_dir \
      AGENT_TOOLKIT_REVIEW_ROOT="$AGENT_TOOLKIT_SESSION_DIR/reviews" \
      TMPDIR="$AGENT_TOOLKIT_SESSION_DIR/tmp" \
      PI_CODING_AGENT_DIR=$agent_dir \
      pi "${pi_args[@]}"
    ;;
  *)
    printf 'invoke this launcher as pi-yolo, codex-yolo, claude-yolo, autoreview-yolo, or pg18-fresh-yolo\n' >&2
    exit 2
    ;;
esac
