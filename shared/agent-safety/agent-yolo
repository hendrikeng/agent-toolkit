#!/usr/bin/env bash
set -euo pipefail

trusted_roots=()
for root in "$HOME/Code" "$HOME/orca/workspaces"; do
  [[ ! -d $root ]] || trusted_roots+=("$root")
done

enable_git_guard() {
  guard=$HOME/.local/libexec/agent-toolkit/git
  marker=$guard.agent-toolkit.sha256
  [[ -x $guard && -f $marker ]] || { printf '%s: run agent-toolkit/install.sh first\n' "${0##*/}" >&2; exit 1; }
  [[ $(<"$marker") == "$(shasum -a 256 "$guard" | awk '{print $1}')" ]] || {
    printf '%s: installed Git guard failed its integrity check\n' "${0##*/}" >&2
    exit 1
  }
  PATH="${guard%/git}:$PATH"
}

case ${0##*/} in
  codex-yolo)
    rules=${CODEX_HOME:-$HOME/.codex}/rules/agent-safety.rules
    [[ -f $rules ]] || { printf 'codex-yolo: run agent-toolkit/install.sh first\n' >&2; exit 1; }
    codex execpolicy check --rules "$rules" -- rm -rf yolo-policy-check | grep -q '"decision":"forbidden"' || {
      printf 'codex-yolo: installed safety policy failed its self-check\n' >&2
      exit 1
    }
    enable_git_guard
    args=(--ask-for-approval never --sandbox workspace-write)
    for root in "${trusted_roots[@]}"; do args+=(--add-dir "$root"); done
    PATH=$PATH exec codex "${args[@]}" "$@"
    ;;
  claude-yolo)
    settings=${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json
    if ! claude_settings=$(node - "$settings" <<'NODE'
const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");
const settings = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
if (settings.sandbox?.enabled !== true || settings.sandbox?.failIfUnavailable !== true || !settings.permissions?.deny?.includes("Bash(rm *)")) process.exit(1);
const network = { allowedDomains: ["localhost", "127.0.0.1"] };
if (process.platform === "darwin") {
  const userData = path.resolve(process.env.ORCA_USER_DATA_PATH || path.join(os.homedir(), "Library", "Application Support", "orca"));
  try {
    const metadata = JSON.parse(fs.readFileSync(path.join(userData, "orca-runtime.json"), "utf8"));
    const transport = [...(metadata.transports ?? []), metadata.transport].find((entry) => entry?.kind === "unix");
    const endpoint = transport?.endpoint && path.resolve(transport.endpoint);
    if (endpoint && path.dirname(endpoint) === userData) network.allowUnixSockets = [endpoint];
  } catch {}
}
process.stdout.write(JSON.stringify({
  permissions: { deny: ["Bash(dangerouslyDisableSandbox:true)", "Bash(*/git *)"] },
  sandbox: { network, filesystem: { disabled: true } },
}));
NODE
    ); then
      printf 'claude-yolo: run agent-toolkit/install.sh first\n' >&2
      exit 1
    fi
    enable_git_guard
    PATH=$PATH exec claude --permission-mode bypassPermissions --settings "$claude_settings" "$@"
    ;;
  pi-yolo)
    source_agent_dir=${AGENT_TOOLKIT_PI_AGENT_DIR:-${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}}
    if [[ -n ${AGENT_TOOLKIT_PI_WEB_CONFIG_DIR:-} ]]; then
      source_web_config_dir=$AGENT_TOOLKIT_PI_WEB_CONFIG_DIR
    elif [[ -n ${PI_CODING_AGENT_DIR:-} ]]; then
      source_web_config_dir=$source_agent_dir
    elif [[ -n ${XDG_CONFIG_HOME:-} ]]; then
      source_web_config_dir=$XDG_CONFIG_HOME/pi
    else
      source_web_config_dir=$HOME/.pi
    fi
    policy=$source_agent_dir/extensions/pi-permission-system/config.json
    [[ -f $policy ]] || { printf 'pi-yolo: run agent-toolkit/install.sh first\n' >&2; exit 1; }

    account_profile=
    codex_accounts_root=$(node -p 'require("node:path").resolve(process.argv[1])' "$HOME/.codex-accounts")
    codex_home=$(node -p 'require("node:path").resolve(process.argv[1])' "${AGENT_TOOLKIT_CODEX_PROFILE_HOME:-${CODEX_HOME:-$HOME/.codex}}")
    case $codex_home in
      "$codex_accounts_root"/*)
        candidate=${codex_home#"$codex_accounts_root"/}
        if [[ $candidate != */* && $candidate =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ && ${AGENT_TOOLKIT_CODEX_ACCOUNT:-$candidate} == "$candidate" ]]; then
          account_profile=$candidate
        fi
        ;;
    esac
    if [[ -z $account_profile && -f $source_agent_dir/active-codex-account.json ]]; then
      candidate=$(node - "$source_agent_dir/active-codex-account.json" <<'NODE'
const fs = require("node:fs");
try {
  const profile = JSON.parse(fs.readFileSync(process.argv[2], "utf8"))?.profile;
  if (typeof profile === "string" && /^[A-Za-z0-9][A-Za-z0-9._-]*$/.test(profile)) process.stdout.write(profile);
} catch {}
NODE
      )
      if [[ -n $candidate && -f $source_agent_dir/auth-profiles/$candidate/auth.json && -f $codex_accounts_root/$candidate/auth.json ]]; then
        account_profile=$candidate
        codex_home=$codex_accounts_root/$candidate
      fi
    fi
    if [[ -n $account_profile ]]; then
      profile_dir=$source_agent_dir/auth-profiles/$account_profile
      profile_auth=$profile_dir/auth.json
      node - "$source_agent_dir/auth.json" "$profile_dir" "$profile_auth" "$codex_home/auth.json" <<'NODE'
const fs = require("node:fs");
const path = require("node:path");
function ensurePrivateDirectory(directory) {
  try { fs.mkdirSync(directory, { mode: 0o700 }); } catch (error) { if (error.code !== "EEXIST") throw error; }
  const stat = fs.lstatSync(directory);
  if (stat.isSymbolicLink() || !stat.isDirectory()) throw new Error(`unsafe profile directory: ${directory}`);
  fs.chmodSync(directory, 0o700);
}
function readJson(file) {
  try { return JSON.parse(fs.readFileSync(file, "utf8")); } catch { return undefined; }
}
function jwtClaims(token) {
  try { return JSON.parse(Buffer.from(token.split(".")[1] || "", "base64url").toString("utf8")); } catch { return {}; }
}
for (const directory of [path.dirname(process.argv[3]), process.argv[3]]) ensurePrivateDirectory(directory);
if (fs.existsSync(process.argv[4])) {
  const stat = fs.lstatSync(process.argv[4]);
  if (stat.isSymbolicLink() || !stat.isFile()) throw new Error(`unsafe profile auth path: ${process.argv[4]}`);
}
let auth = readJson(process.argv[4]);
const existing = Boolean(auth);
if (!auth) {
  auth = readJson(process.argv[2]) || {};
  auth = Object.fromEntries(Object.entries(auth).filter(([, credential]) => credential?.type !== "oauth"));
}
let changed = false;
const codex = readJson(process.argv[5]);
const access = codex?.tokens?.access_token;
const refresh = codex?.tokens?.refresh_token;
const claims = typeof access === "string" ? jwtClaims(access) : {};
const accountId = codex?.tokens?.account_id || claims["https://api.openai.com/auth"]?.chatgpt_account_id;
const credential = auth["openai-codex"];
const codexExpires = Number(claims.exp) * 1000;
const credentialExpires = Number(credential?.expires) || Number(jwtClaims(credential?.access).exp) * 1000 || 0;
if (
  typeof access === "string" && typeof refresh === "string" && typeof accountId === "string"
  && (!credential?.access || codexExpires > credentialExpires)
) {
  auth["openai-codex"] = { type: "oauth", access, refresh, expires: Number.isFinite(codexExpires) && codexExpires > 0 ? codexExpires : Date.now() + 300000, accountId };
  changed = true;
}
if (!existing) {
  try { fs.writeFileSync(process.argv[4], `${JSON.stringify(auth, null, 2)}\n`, { flag: "wx", mode: 0o600 }); } catch (error) { if (error.code !== "EEXIST") throw error; }
} else if (changed) {
  const temporary = `${process.argv[4]}.${process.pid}`;
  fs.writeFileSync(temporary, `${JSON.stringify(auth, null, 2)}\n`, { mode: 0o600 });
  fs.renameSync(temporary, process.argv[4]);
}
const authStat = fs.lstatSync(process.argv[4]);
if (authStat.isSymbolicLink() || !authStat.isFile()) throw new Error(`unsafe profile auth path: ${process.argv[4]}`);
fs.chmodSync(process.argv[4], 0o600);
const stored = readJson(process.argv[4]);
const storedCredential = stored?.["openai-codex"];
if (typeof storedCredential?.access !== "string" || typeof storedCredential?.refresh !== "string" || typeof storedCredential?.accountId !== "string") {
  throw new Error(`invalid profile auth: ${process.argv[4]}`);
}
if (codex?.tokens && typeof access === "string" && typeof refresh === "string") {
  const storedExpires = Number(storedCredential.expires) || Number(jwtClaims(storedCredential.access).exp) * 1000 || 0;
  if (storedCredential.access !== access && storedExpires < codexExpires) throw new Error("Codex login was not imported");
  delete codex.tokens.access_token;
  delete codex.tokens.refresh_token;
  const temporary = `${process.argv[5]}.${process.pid}`;
  fs.writeFileSync(temporary, `${JSON.stringify(codex, null, 2)}\n`, { mode: 0o600 });
  fs.renameSync(temporary, process.argv[5]);
}
NODE
      agent_dir=$(mktemp -d "${TMPDIR:-/tmp}/agent-toolkit-pi-yolo.XXXXXX")
      trap 'rm -rf "$agent_dir"' EXIT
      cp "$profile_auth" "$agent_dir/auth.json"
      chmod 600 "$agent_dir/auth.json"
      for source in "$source_agent_dir"/*; do
        name=${source##*/}
        [[ $name == auth.json || $name == auth-profiles || $name == extensions ]] || ln -s "$source" "$agent_dir/$name"
      done
      mkdir "$agent_dir/extensions"
      for source in "$source_agent_dir/extensions"/*; do
        name=${source##*/}
        [[ $name == pi-permission-system ]] || ln -s "$source" "$agent_dir/extensions/$name"
      done
      mkdir "$agent_dir/extensions/pi-permission-system"
    else
      agent_dir=$(mktemp -d "${TMPDIR:-/tmp}/agent-toolkit-pi-yolo.XXXXXX")
      trap 'rm -rf "$agent_dir"' EXIT
      for source in "$source_agent_dir"/*; do
        [[ ${source##*/} == extensions ]] || ln -s "$source" "$agent_dir/${source##*/}"
      done
      mkdir "$agent_dir/extensions"
      for source in "$source_agent_dir/extensions"/*; do
        [[ ${source##*/} == pi-permission-system ]] || ln -s "$source" "$agent_dir/extensions/${source##*/}"
      done
      mkdir "$agent_dir/extensions/pi-permission-system"
    fi
    node - "$policy" "$agent_dir/extensions/pi-permission-system/config.json" <<'NODE'
const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");
const config = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
for (const pattern of ["rm *", "git clean *", "git reset --hard", "command *", "exec *"]) {
  if (config.permission?.bash?.[pattern] !== "deny") throw new Error(`unsafe Pi yolo policy: ${pattern}`);
}
for (const pattern of ["*.env", "*.env.*", "*.pem", "*.key"]) {
  config.permission.path[pattern] = "deny";
}
const managedAgentDir = fs.realpathSync(path.resolve(process.argv[2], "../../.."));
const runtimeAgentDir = fs.realpathSync(path.resolve(process.argv[3], "../../.."));
config.permission.path[path.join(runtimeAgentDir, "auth.json")] = "deny";
config.permission.path[path.join(runtimeAgentDir, "codex-runtimes", "*", "auth.json")] = "deny";
const temporaryDir = fs.realpathSync(os.tmpdir());
config.piInfrastructureReadPaths = [...new Set([
  ...(config.piInfrastructureReadPaths ?? []),
  path.join(managedAgentDir, "git"),
  path.join(managedAgentDir, "npm/node_modules"),
  // Orca and terminal clipboard integrations put pasted images here.
  path.join(temporaryDir, "orca-paste-*"),
  path.join(temporaryDir, "pi-clipboard-*"),
  path.join(temporaryDir, "codex-clipboard-*"),
])];
config.permission.external_directory = { "*": "deny" };
for (const root of [path.join(process.env.HOME, "Code"), path.join(process.env.HOME, "orca/workspaces")]) {
  config.permission.external_directory[root] = "allow";
  config.permission.external_directory[path.join(root, "*")] = "allow";
}
config.yoloMode = true;
config.permission.bash["*/git *"] = "deny";
for (const wrapper of ["eval", "sudo", "env", "xargs", "time", "nohup", "timeout", "nice", "parallel", "rust-parallel", "rush", "doas", "setsid", "stdbuf", "watch", "flock", "bash", "sh", "dash", "zsh", "ksh"]) {
  config.permission.bash[`${wrapper} *`] = "deny";
  config.permission.bash[`*/${wrapper} *`] = "deny";
}
for (const pattern of ["find * -exec*", "*/find * -exec*", "find * -ok*", "*/find * -ok*", "fd * -x *", "*/fd * -x *", "fd * -X *", "*/fd * -X *", "fd * --exec*", "*/fd * --exec*"]) {
  config.permission.bash[pattern] = "deny";
}
const output = process.argv[3];
const temporary = `${output}.${process.pid}`;
fs.writeFileSync(temporary, `${JSON.stringify(config, null, 2)}\n`);
fs.renameSync(temporary, output);
NODE

    enable_git_guard
    if [[ -n $account_profile ]]; then
      export AGENT_TOOLKIT_CODEX_PROFILE_HOME=$codex_home
    else
      unset AGENT_TOOLKIT_CODEX_PROFILE_HOME
    fi
    PATH=$PATH AGENT_TOOLKIT_CODEX_ACCOUNT=$account_profile AGENT_TOOLKIT_PI_AGENT_DIR=$source_agent_dir AGENT_TOOLKIT_PI_WEB_CONFIG_DIR=$source_web_config_dir PI_CODING_AGENT_DIR=$agent_dir pi "$@"
    ;;
  *)
    printf 'invoke this launcher as pi-yolo, codex-yolo, or claude-yolo\n' >&2
    exit 2
    ;;
esac
