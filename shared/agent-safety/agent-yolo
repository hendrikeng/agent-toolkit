#!/usr/bin/env bash
set -euo pipefail

trusted_roots=()
for root in "$HOME/Code" "$HOME/orca/workspaces"; do
  [[ ! -d $root ]] || trusted_roots+=("$root")
done

enable_git_guard() {
  guard=${AGENT_TOOLKIT_PERMISSION_BUNDLE:+$AGENT_TOOLKIT_PERMISSION_BUNDLE/git}
  guard=${guard:-$HOME/.local/libexec/agent-toolkit/git}
  marker=$guard.agent-toolkit.sha256
  [[ -x $guard && -f $marker ]] || { printf '%s: run agent-toolkit/install.sh first\n' "${0##*/}" >&2; exit 1; }
  [[ $(<"$marker") == "$(shasum -a 256 "$guard" | awk '{print $1}')" ]] || {
    printf '%s: installed Git guard failed its integrity check\n' "${0##*/}" >&2
    exit 1
  }
  # These inherited transport settings are already fixed arguments in the managed guard.
  # Leave every other override untouched so the guard continues to reject it.
  if [[ ${GIT_CONFIG_COUNT:-} == 2 && ${GIT_CONFIG_VALUE_0:-} == false && ${GIT_CONFIG_VALUE_1:-} == false ]] &&
     { [[ ${GIT_CONFIG_KEY_0:-} == credential.interactive && ${GIT_CONFIG_KEY_1:-} == credential.guiPrompt ]] ||
       [[ ${GIT_CONFIG_KEY_1:-} == credential.interactive && ${GIT_CONFIG_KEY_0:-} == credential.guiPrompt ]]; }; then
    grep -q '^GIT_TERMINAL_PROMPT=0 exec .* -c credential.interactive=false -c credential.guiPrompt=false ' "$guard" || {
      printf '%s: installed Git guard must preserve non-interactive credentials; update it first\n' "${0##*/}" >&2
      exit 1
    }
    unset GIT_CONFIG_COUNT GIT_CONFIG_KEY_0 GIT_CONFIG_VALUE_0 GIT_CONFIG_KEY_1 GIT_CONFIG_VALUE_1
  fi
  PATH="${guard%/git}:$PATH"
}

case ${0##*/} in
  codex-yolo)
    rules=${CODEX_HOME:-$HOME/.codex}/rules/agent-safety.rules
    [[ -f $rules ]] || { printf 'codex-yolo: run agent-toolkit/install.sh first\n' >&2; exit 1; }
    codex execpolicy check --rules "$rules" -- rm -rf yolo-policy-check | grep -q '"decision":"forbidden"' || {
      printf 'codex-yolo: installed safety policy failed its self-check\n' >&2
      exit 1
    }
    enable_git_guard
    args=(--ask-for-approval never --sandbox workspace-write)
    for root in "${trusted_roots[@]}"; do args+=(--add-dir "$root"); done
    PATH=$PATH exec codex "${args[@]}" "$@"
    ;;
  claude-yolo)
    settings=${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json
    if ! claude_settings=$(node - "$settings" <<'NODE'
const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");
const settings = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
if (settings.sandbox?.enabled !== true || settings.sandbox?.failIfUnavailable !== true || !settings.permissions?.deny?.includes("Bash(rm *)")) process.exit(1);
const network = { allowedDomains: ["localhost", "127.0.0.1"] };
if (process.platform === "darwin") {
  const userData = path.resolve(process.env.ORCA_USER_DATA_PATH || path.join(os.homedir(), "Library", "Application Support", "orca"));
  try {
    const metadata = JSON.parse(fs.readFileSync(path.join(userData, "orca-runtime.json"), "utf8"));
    const transport = [...(metadata.transports ?? []), metadata.transport].find((entry) => entry?.kind === "unix");
    const endpoint = transport?.endpoint && path.resolve(transport.endpoint);
    if (endpoint && path.dirname(endpoint) === userData) network.allowUnixSockets = [endpoint];
  } catch {}
}
process.stdout.write(JSON.stringify({
  permissions: { deny: ["Bash(dangerouslyDisableSandbox:true)", "Bash(*/git *)"] },
  sandbox: { network, filesystem: { disabled: true } },
}));
NODE
    ); then
      printf 'claude-yolo: run agent-toolkit/install.sh first\n' >&2
      exit 1
    fi
    enable_git_guard
    PATH=$PATH exec claude --permission-mode bypassPermissions --settings "$claude_settings" "$@"
    ;;
  pi-yolo)
    bundle=${AGENT_TOOLKIT_PERMISSION_BUNDLE:-}
    [[ -n $bundle ]] || { printf 'Installation [development-roots-v1]: use the atomic permission-bundle launcher\n' >&2; exit 1; }
    node "$bundle/permission-bundle.cjs" verify "$bundle"
    required_pi=$(node -p 'JSON.parse(require("node:fs").readFileSync(process.argv[1])).piVersion' "$bundle/manifest.json")
    [[ $(pi --version) == "$required_pi" ]] || { printf 'Installation [development-roots-v1]: Pi version changed; reviewed bundle installation required\n' >&2; exit 1; }
    source_agent_dir=${AGENT_TOOLKIT_PI_AGENT_DIR:-${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}}
    if [[ -n ${AGENT_TOOLKIT_PI_WEB_CONFIG_DIR:-} ]]; then
      source_web_config_dir=$AGENT_TOOLKIT_PI_WEB_CONFIG_DIR
    elif [[ -n ${PI_CODING_AGENT_DIR:-} ]]; then
      source_web_config_dir=$source_agent_dir
    elif [[ -n ${XDG_CONFIG_HOME:-} ]]; then
      source_web_config_dir=$XDG_CONFIG_HOME/pi
    else
      source_web_config_dir=$HOME/.pi
    fi
    policy=$bundle/policy.json
    [[ -f $policy ]] || { printf 'pi-yolo: run agent-toolkit/install.sh first\n' >&2; exit 1; }

    account_profile=
    pinned_account=false
    codex_accounts_root=$(node -p 'require("node:path").resolve(process.argv[1])' "$HOME/.codex-accounts")
    codex_home=$(node -p 'require("node:path").resolve(process.argv[1])' "${AGENT_TOOLKIT_CODEX_PROFILE_HOME:-${CODEX_HOME:-$HOME/.codex}}")
    if [[ -n ${AGENT_TOOLKIT_CODEX_ACCOUNT_EMAIL_B64:-} ]]; then
      [[ -n ${AGENT_TOOLKIT_CODEX_ACCOUNT_ID:-} && ${AGENT_TOOLKIT_CODEX_PROFILE_SHA256:-} =~ ^[a-f0-9]{64}$ ]] || { printf 'pi-yolo: incomplete selected account identity\n' >&2; exit 1; }
      account_profile=$(node --experimental-strip-types --input-type=module - "$source_agent_dir/extensions/codex-account/index.ts" "$source_agent_dir" "$codex_accounts_root" "$AGENT_TOOLKIT_CODEX_ACCOUNT_EMAIL_B64" "${AGENT_TOOLKIT_CODEX_ACCOUNT_ID:-}" "${AGENT_TOOLKIT_CODEX_PROFILE_SHA256:-}" <<'NODE'
import { createHash } from "node:crypto";
import { join } from "node:path";
import { pathToFileURL } from "node:url";
const { piAccountEmail, piAccounts, piProfileAccountId } = await import(pathToFileURL(process.argv[2]).href);
const email = Buffer.from(process.argv[5], "base64url").toString("utf8");
const matches = piAccounts(process.argv[3], process.argv[4]).filter(({ profile }) =>
  piAccountEmail(join(process.argv[3], "auth-profiles", profile))?.toLowerCase() === email.toLowerCase()
  && piProfileAccountId(profile, process.argv[3]) === process.argv[6]
  && createHash("sha256").update(profile).digest("hex") === process.argv[7]
).sort((a, b) => a.profile.localeCompare(b.profile));
if (!matches.length) process.exit(1);
process.stdout.write(matches[0].profile);
NODE
      ) || { printf 'pi-yolo: no unique login found for selected email\n' >&2; exit 1; }
      codex_home=$codex_accounts_root/$account_profile
      pinned_account=true
    else
      case $codex_home in
        "$codex_accounts_root"/*)
          candidate=${codex_home#"$codex_accounts_root"/}
          if [[ $candidate != */* && $candidate =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ && ${AGENT_TOOLKIT_CODEX_ACCOUNT:-$candidate} == "$candidate" ]]; then
            account_profile=$candidate
          fi
          ;;
      esac
      if [[ -z $account_profile && -f $source_agent_dir/active-codex-account.json ]]; then
        candidate=$(node - "$source_agent_dir/active-codex-account.json" <<'NODE'
const fs = require("node:fs");
try {
  const profile = JSON.parse(fs.readFileSync(process.argv[2], "utf8"))?.profile;
  if (typeof profile === "string" && /^[A-Za-z0-9][A-Za-z0-9._-]*$/.test(profile)) process.stdout.write(profile);
} catch {}
NODE
        )
        if [[ -n $candidate && -f $source_agent_dir/auth-profiles/$candidate/auth.json && -f $codex_accounts_root/$candidate/auth.json ]]; then
          account_profile=$candidate
          codex_home=$codex_accounts_root/$candidate
        fi
      fi
    fi
    unset AGENT_TOOLKIT_CODEX_ACCOUNT_EMAIL_B64 AGENT_TOOLKIT_CODEX_ACCOUNT_ID AGENT_TOOLKIT_CODEX_PROFILE_SHA256
    agent_dir=$(mktemp -d "${TMPDIR:-/tmp}/agent-toolkit-pi-session.XXXXXX")
    agent_dir=$(cd -P "$agent_dir" && pwd -P)
    if [[ -n $account_profile ]]; then
      profile_dir=$source_agent_dir/auth-profiles/$account_profile
      profile_auth=$profile_dir/auth.json
      node - "$source_agent_dir/auth.json" "$profile_dir" "$profile_auth" "$codex_home/auth.json" "$pinned_account" <<'NODE'
const fs = require("node:fs");
const path = require("node:path");
function ensurePrivateDirectory(directory) {
  try { fs.mkdirSync(directory, { mode: 0o700 }); } catch (error) { if (error.code !== "EEXIST") throw error; }
  const stat = fs.lstatSync(directory);
  if (stat.isSymbolicLink() || !stat.isDirectory()) throw new Error(`unsafe profile directory: ${directory}`);
  fs.chmodSync(directory, 0o700);
}
function readJson(file) {
  try { return JSON.parse(fs.readFileSync(file, "utf8")); } catch { return undefined; }
}
function jwtClaims(token) {
  try { return JSON.parse(Buffer.from(token.split(".")[1] || "", "base64url").toString("utf8")); } catch { return {}; }
}
for (const directory of [path.dirname(process.argv[3]), process.argv[3]]) ensurePrivateDirectory(directory);
if (fs.existsSync(process.argv[4])) {
  const stat = fs.lstatSync(process.argv[4]);
  if (stat.isSymbolicLink() || !stat.isFile()) throw new Error(`unsafe profile auth path: ${process.argv[4]}`);
}
let auth = readJson(process.argv[4]);
const existing = Boolean(auth);
if (!auth) {
  auth = readJson(process.argv[2]) || {};
  auth = Object.fromEntries(Object.entries(auth).filter(([, credential]) => credential?.type !== "oauth"));
}
let changed = false;
const codex = process.argv[6] === "true" ? undefined : readJson(process.argv[5]);
const access = codex?.tokens?.access_token;
const refresh = codex?.tokens?.refresh_token;
const claims = typeof access === "string" ? jwtClaims(access) : {};
const accountId = codex?.tokens?.account_id || claims["https://api.openai.com/auth"]?.chatgpt_account_id;
const credential = auth["openai-codex"];
const codexExpires = Number(claims.exp) * 1000;
const credentialExpires = Number(credential?.expires) || Number(jwtClaims(credential?.access).exp) * 1000 || 0;
if (
  typeof access === "string" && typeof refresh === "string" && typeof accountId === "string"
  && (!credential?.access || codexExpires > credentialExpires)
) {
  auth["openai-codex"] = { type: "oauth", access, refresh, expires: Number.isFinite(codexExpires) && codexExpires > 0 ? codexExpires : Date.now() + 300000, accountId };
  changed = true;
}
if (!existing) {
  try { fs.writeFileSync(process.argv[4], `${JSON.stringify(auth, null, 2)}\n`, { flag: "wx", mode: 0o600 }); } catch (error) { if (error.code !== "EEXIST") throw error; }
} else if (changed) {
  const temporary = `${process.argv[4]}.${process.pid}`;
  fs.writeFileSync(temporary, `${JSON.stringify(auth, null, 2)}\n`, { mode: 0o600 });
  fs.renameSync(temporary, process.argv[4]);
}
const authStat = fs.lstatSync(process.argv[4]);
if (authStat.isSymbolicLink() || !authStat.isFile()) throw new Error(`unsafe profile auth path: ${process.argv[4]}`);
fs.chmodSync(process.argv[4], 0o600);
const stored = readJson(process.argv[4]);
const storedCredential = stored?.["openai-codex"];
if (typeof storedCredential?.access !== "string" || typeof storedCredential?.refresh !== "string" || typeof storedCredential?.accountId !== "string") {
  throw new Error(`invalid profile auth: ${process.argv[4]}`);
}
if (codex?.tokens && typeof access === "string" && typeof refresh === "string") {
  const storedExpires = Number(storedCredential.expires) || Number(jwtClaims(storedCredential.access).exp) * 1000 || 0;
  if (storedCredential.access !== access && storedExpires < codexExpires) throw new Error("Codex login was not imported");
  delete codex.tokens.access_token;
  delete codex.tokens.refresh_token;
  const temporary = `${process.argv[5]}.${process.pid}`;
  fs.writeFileSync(temporary, `${JSON.stringify(codex, null, 2)}\n`, { mode: 0o600 });
  fs.renameSync(temporary, process.argv[5]);
}
NODE
      cp "$profile_auth" "$agent_dir/auth.json"
      chmod 600 "$agent_dir/auth.json"
      for source in "$source_agent_dir"/*; do
        name=${source##*/}
        [[ $name == auth.json || $name == auth-profiles || $name == extensions ]] || ln -s "$source" "$agent_dir/$name"
      done
      mkdir "$agent_dir/extensions"
      for source in "$source_agent_dir/extensions"/*; do
        name=${source##*/}
        [[ $name == pi-permission-system ]] || ln -s "$source" "$agent_dir/extensions/$name"
      done
      mkdir "$agent_dir/extensions/pi-permission-system"
    else
      for source in "$source_agent_dir"/*; do
        [[ ${source##*/} == extensions ]] || ln -s "$source" "$agent_dir/${source##*/}"
      done
      mkdir "$agent_dir/extensions"
      for source in "$source_agent_dir/extensions"/*; do
        [[ ${source##*/} == pi-permission-system ]] || ln -s "$source" "$agent_dir/extensions/${source##*/}"
      done
      mkdir "$agent_dir/extensions/pi-permission-system"
    fi
    node - "$policy" "$agent_dir/extensions/pi-permission-system/config.json" "$bundle" "$source_agent_dir" <<'NODE'
const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");
const config = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
for (const pattern of ["rm*", "git clean *", "git reset --hard", "command *", "exec *"]) {
  if (config.permission?.bash?.[pattern] !== "deny") throw new Error(`unsafe Pi yolo policy: ${pattern}`);
}
for (const pattern of ["*.env", "*.env.*", "*.pem", "*.key"]) {
  config.permission.path[pattern] = "deny";
}
const managedAgentDir = fs.realpathSync(process.argv[5]);
const bundle = process.argv[4];
const access = require(path.join(bundle, "development-policy.cjs"));
access.assertDevelopmentPath(process.cwd(), access.developmentRoots(os.homedir()));
const runtimeAgentDir = fs.realpathSync(path.resolve(process.argv[3], "../../.."));
for (const surface of ["write", "edit"]) config.permission[surface] = { ...config.permission.path, [runtimeAgentDir]: "deny", [path.join(runtimeAgentDir, "*")]: "deny" };
config.permission.bash[`*${runtimeAgentDir}*`] = "deny";
config.permission.path[path.join(runtimeAgentDir, "auth.json")] = "deny";
config.permission.path[path.join(runtimeAgentDir, "codex-runtimes", "*", "auth.json")] = "deny";
config.permission.external_directory[runtimeAgentDir] = "allow";
config.permission.external_directory[path.join(runtimeAgentDir, "*")] = "allow";
const temporaryDir = fs.realpathSync(os.tmpdir());
const reviewRoot = path.join(os.homedir(), "Code/.agent-toolkit-reports");
fs.mkdirSync(reviewRoot, { recursive: true, mode: 0o700 });
if (fs.lstatSync(reviewRoot).isSymbolicLink()) throw new Error("Review results directory must not be a symlink");
const probe = path.join(reviewRoot, ".read-probe.txt");
const probeText = "Pi review results read access is available.\n";
try { fs.writeFileSync(probe, probeText, { flag: "wx", mode: 0o600 }); }
catch (error) { if (error.code !== "EEXIST") throw error; }
if (!fs.lstatSync(probe).isFile() || fs.lstatSync(probe).isSymbolicLink() || fs.readFileSync(probe, "utf8") !== probeText) throw new Error("Invalid review read-access probe");
config.piInfrastructureReadPaths = [...new Set([
  ...(config.piInfrastructureReadPaths ?? []),
  fs.realpathSync(reviewRoot),
  path.join(runtimeAgentDir, "extensions"),
  path.join(runtimeAgentDir, "skills"),
  path.join(managedAgentDir, "extensions"),
  path.join(managedAgentDir, "skills"),
  path.join(os.homedir(), ".agents/skills"),
  path.join(os.homedir(), ".claude/skills"),
  path.join(os.homedir(), ".codex/skills"),
  path.join(managedAgentDir, "git"),
  path.join(managedAgentDir, "npm/node_modules"),
  // Orca and terminal clipboard integrations put pasted images here.
  path.join(temporaryDir, "orca-paste-*"),
  path.join(temporaryDir, "pi-clipboard-*"),
  path.join(temporaryDir, "codex-clipboard-*"),
])];
// The accepted bundle supplies one policy. Never import checkout approvals or
// rewrite human asks/denials at session startup.
const settings = JSON.parse(fs.readFileSync(path.join(managedAgentDir, "settings.json"), "utf8"));
settings.packages = (settings.packages ?? []).filter(item => !JSON.stringify(item).includes("pi-permission-system"));
settings.packages.push(path.join(bundle, "node_modules/@gotgenes/pi-permission-system"));
const runtimeSettings = path.join(runtimeAgentDir, "settings.json");
if (fs.lstatSync(runtimeSettings).isSymbolicLink()) fs.unlinkSync(runtimeSettings);
fs.writeFileSync(runtimeSettings, JSON.stringify(settings, null, 2));
// Pi can resolve symlinked extensions from their session path, not their bundle
// path. Keep dependency lookup pinned to this bundle in both cases.
const runtimeModules = path.join(runtimeAgentDir, "node_modules");
try {
  if (!fs.lstatSync(runtimeModules).isSymbolicLink()) throw new Error("Unexpected runtime dependency destination");
  fs.unlinkSync(runtimeModules);
} catch (error) { if (error.code !== "ENOENT") throw error; }
fs.symlinkSync(path.join(bundle, "node_modules"), runtimeModules);
for (const name of ["development-access", "task-graph"]) {
  const target = path.join(runtimeAgentDir, "extensions", name);
  if (fs.existsSync(target)) {
    if (!fs.lstatSync(target).isSymbolicLink()) throw new Error("Unexpected runtime extension destination");
    fs.unlinkSync(target);
  }
  fs.symlinkSync(path.join(bundle, "extensions", name), target);
}
// Optional fixture helpers must not prevent ordinary Pi startup. If absent or
// changed, deny their command surface rather than falling through to another PATH binary.
for (const name of ["pg-test", "git-test"]) {
  const helper = path.join(process.env.HOME, ".local/libexec/agent-toolkit", name);
  try {
    for (const file of [helper, `${helper}.agent-toolkit.sha256`]) {
      const stat = fs.lstatSync(file);
      if (!stat.isFile() || stat.isSymbolicLink()) throw Error("Unmanaged fixture helper");
    }
    fs.accessSync(helper, fs.constants.X_OK);
    if (fs.readFileSync(`${helper}.agent-toolkit.sha256`, "utf8").trim() !== require("node:crypto").createHash("sha256").update(fs.readFileSync(helper)).digest("hex")) throw Error("Changed fixture helper");
  } catch {
    for (const pattern of [name, `${name} *`, `*/${name}`, `*/${name} *`]) config.permission.bash[pattern] = "deny";
  }
}
// Legacy script approvals are intentionally not imported, even if files still exist.
// Missing approvals therefore cannot abort launcher startup or authorize a new clone.
const output = process.argv[3];
const temporary = `${output}.${process.pid}`;
fs.writeFileSync(temporary, `${JSON.stringify(config, null, 2)}\n`);
fs.renameSync(temporary, output);
NODE

    enable_git_guard
    if [[ -n $account_profile ]]; then
      export AGENT_TOOLKIT_CODEX_PROFILE_HOME=$codex_home
    else
      unset AGENT_TOOLKIT_CODEX_PROFILE_HOME
    fi
    has_model=false
    has_thinking=false
    for argument in "$@"; do
      [[ $argument != -- ]] || break
      case $argument in --model|--model=*) has_model=true ;; --thinking|--thinking=*) has_thinking=true ;; esac
    done
    pi_args=()
    [[ $has_model == true ]] || pi_args+=(--model openai-codex/gpt-5.6-sol)
    [[ $has_thinking == true ]] || pi_args+=(--thinking high)
    pi_args+=("$@")
    PATH=$PATH \
      AGENT_TOOLKIT_CODEX_ACCOUNT=$account_profile \
      AGENT_TOOLKIT_PI_AGENT_DIR=$source_agent_dir \
      AGENT_TOOLKIT_PI_WEB_CONFIG_DIR=$source_web_config_dir \
      AGENT_TOOLKIT_REVIEW_ROOT="$HOME/Code/.agent-toolkit-reports" \
      AGENT_TOOLKIT_PERMISSION_BUNDLE="$bundle" \
      PI_CODING_AGENT_DIR=$agent_dir \
      pi "${pi_args[@]}"
    ;;
  *)
    printf 'invoke this launcher as pi-yolo, codex-yolo, or claude-yolo\n' >&2
    exit 2
    ;;
esac
