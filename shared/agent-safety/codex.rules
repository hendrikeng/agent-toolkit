# Destructive commands stay available, but require explicit approval.
for command in [
    ["rm"],
    ["rmdir"],
    ["unlink"],
    ["shred"],
    ["truncate"],
    ["dd"],
    ["/bin/rm"],
    ["/usr/bin/rm"],
    ["/bin/rmdir"],
    ["/usr/bin/rmdir"],
    ["/usr/bin/unlink"],
    ["/usr/bin/shred"],
    ["/usr/bin/truncate"],
    ["/bin/dd"],
    ["/usr/bin/dd"],
    ["command"],
    ["exec"],
    ["env"],
    ["/usr/bin/env"],
    ["sudo"],
    ["/usr/bin/sudo"],
    [["bash", "sh", "zsh", "/bin/bash", "/bin/sh", "/bin/zsh"], "-c"],
    # Prefix rules cannot skip Git global options, so gate common option forms broadly.
    ["git", ["-C", "-c", "-p", "-P", "--paginate", "--no-pager", "--no-replace-objects", "--bare", "--git-dir", "--work-tree", "--namespace", "--super-prefix", "--config-env", "--exec-path", "--html-path", "--man-path", "--info-path", "--literal-pathspecs", "--glob-pathspecs", "--noglob-pathspecs", "--icase-pathspecs", "--no-optional-locks", "--no-advice", "--no-lazy-fetch"]],
    [["/usr/bin/git", "/usr/local/bin/git", "/opt/homebrew/bin/git"]],
    ["git", "clean"],
    ["git", "reset", "--hard"],
    ["git", "checkout", "--"],
    ["git", "restore"],
    ["git", "branch", "-D"],
]:
    prefix_rule(
        pattern = command,
        decision = "prompt",
        justification = "Destructive command requires approval to protect recoverable work and data.",
    )
